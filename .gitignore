# ==============================================================================
# Filipino Sign Language (FSL) Translation Engine - Git Ignore
# ==============================================================================

# Virtual Environments
.venv/
env/
venv/
ENV/
*.venv/

# Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDEs & System Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Android Studio & Gradle
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/.kotlin/
android/*.iml
android/**/*.iml
android/local.properties
android/.cxx/
android/.externalNativeBuild/
android/captures/

# Temporary logs & crash dumps
*.log
*.tmp

# Preserve production models, vocabs, and MediaPipe landmark task assets
!models/best_model.pt
!models/robust_model.pt
!models/fsl_model.onnx
!models/vocab.json
!models/tasks/*.task
