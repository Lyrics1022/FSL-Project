<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <!-- Main Screen Content -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Top Bar: Hamburger Menu + "Translate" + Language Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Navigation Menu"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Translate"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/chipLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_language"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="FSL → English"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Camera Viewfinder Card with Shutter Button inside -->
        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_camera_frame"
            android:clipToOutline="true">

            <!-- CameraX Viewfinder -->
            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/camera_bg"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />

            <!-- Hand Detection Bounding Box & Signage Overlay -->
            <com.example.sign_language_translator.LandmarkOverlayView
                android:id="@+id/landmarkOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Recording Timer Pill -->
            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:background="@drawable/bg_chip_recording"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imgTimerDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/dot_recording" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="0.0s / 2.5s"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Flip Camera Button -->
            <ImageButton
                android:id="@+id/btnFlipCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="Flip Camera"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_flip_camera" />

            <!-- Real-Time Signing Action Controller (Overlapping camera screen like first video) -->
            <LinearLayout
                android:id="@+id/layoutActionControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Circular Action Button -->
                <FrameLayout
                    android:id="@+id/btnRecord"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_button_signing_idle">

                    <ImageView
                        android:id="@+id/imgActionIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_hand_signing"
                        android:contentDescription="Sign Language Translation Button" />
                </FrameLayout>

                <!-- State Description Label -->
                <TextView
                    android:id="@+id/tvActionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Start signing"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="4"
                    android:textSize="13sp" />
            </LinearLayout>

        </FrameLayout>

        <!-- Translation Card -->
        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Card Header: "TRANSLATION" + Volume/Pronunciation Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:text="TRANSLATION"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnSpeak"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Pronounce Translation Audio"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Translation Result Text: "Ready when you are" (idle) or Sign name (result) -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-bold"
                android:text="Ready when you are"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="italic"
                tools:text="Hello"
                tools:textColor="@color/text_primary"
                tools:textStyle="normal" />

            <!-- Accuracy / Confidence Progress Bar & Label -->
            <LinearLayout
                android:id="@+id/groupAccuracy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/progressConfidence"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_confidence"
                    tools:progress="64" />

                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="64% CONFIDENT"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    tools:text="64% CONFIDENT" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Side Navigation Drawer (Opens with Hamburger Menu) -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#091420"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="FSL Translator"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Menu"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                android:visibility="visible"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Filipino Sign Language • Offline Engine"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/border" />

        <!-- Menu Section 1 -->
        <TextView
            android:id="@+id/menuVocab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Active Vocabulary (105 Signs)"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <!-- Menu Section 2 -->
        <TextView
            android:id="@+id/menuModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Model: BiLSTM + ONNX (Offline)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Menu Section 3 -->
        <TextView
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="About FSL Project"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Version 1.0.0"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>